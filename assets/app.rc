// Resources compiled into the exe by build.rs. Icon 1 is the exe icon Explorer shows.
#include <winres.h>

1 ICON "app.ico"
2 ICON "tray-locked.ico"
3 ICON "tray-unlocked.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "saheer-ahamed"
            VALUE "FileDescription", "DontUseMySystem"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "dontusemysystem"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "dontusemysystem.exe"
            VALUE "ProductName", "DontUseMySystem"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
